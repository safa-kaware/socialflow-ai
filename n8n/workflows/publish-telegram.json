      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst d = b.draft || {};\n\nif (!String(d.content || '').trim()) {\n  throw new Error('No content to publish');\n}\n\nconst tags = Array.isArray(d.hashtags) ? d.hashtags.join(' ') : '';\nconst parts = [d.title, d.content, d.callToAction, tags]\n  .map((s) => String(s || '').trim())\n  .filter(Boolean);\n\nconst text = parts.join('\\n\\n').slice(0, 4000);\n\nreturn [{ json: { text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
